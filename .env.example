# Copy to .env for local use (npm scripts load it automatically).
# On Vercel, set these under Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# The venue's time zone, used for "today" and roster weeks (Vercel runs in UTC).
APP_TZ=Australia/Sydney

# true when served over HTTPS (always on Vercel).
COOKIE_SECURE=false

# Roster emails. Leave SMTP_HOST unset to only print emails to the log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Punchcard <roster@yourshop.com>"
